{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expo.dev/schemas/explore/build-catalog.v1.schema.json",
  "title": "Expo Explore build catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "name",
    "currentBuildId",
    "defaultBaselineBuildId",
    "builds",
    "comparisons"
  ],
  "properties": {
    "contract": { "const": "expo.explore.build-catalog.v1" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "currentBuildId": { "$ref": "#/$defs/id" },
    "defaultBaselineBuildId": { "$ref": "#/$defs/id" },
    "builds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/build" }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/comparison" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "mapDir"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "build" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "mapDir": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineBuildId", "currentBuildId", "path"],
      "properties": {
        "baselineBuildId": { "$ref": "#/$defs/id" },
        "currentBuildId": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
